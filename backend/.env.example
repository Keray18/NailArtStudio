# ==============================================================================
# The Nail Lounge — Backend Environment Variables Configuration Template
# ==============================================================================
# Copy this file to .env and replace placeholders with your local environment values.
# DO NOT commit real secrets or credentials to source control.

# Application Environment
NODE_ENV=development
PORT=4000

# Client Application URL for CORS Whitelisting
FRONTEND_ORIGIN=http://localhost:3000

# PostgreSQL Connection String (Prisma ORM)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/the_nail_lounge?schema=public"

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging Level (debug | info | warn | error)
LOG_LEVEL=info

